+async fn client_bounds(window_id: u64) -> Option<WindowBounds> {
+    let mut command = TokioCommand::new("xwininfo");
+    command.args(["-id", &window_id.to_string(), "-stats"]).env("LC_ALL", "C");
+    let output = command_runner::output(command, "query X11 client bounds").await.ok()?;
+    if !output.status.success() { return None; }
+    let text = String::from_utf8_lossy(&output.stdout);
+    let field = |label: &str| -> Option<i32> {
+        text.lines().find_map(|line| line.trim().strip_prefix(label)?.trim().parse().ok())
+    };
+    Some(WindowBounds {
+        x: Some(field("Absolute upper-left X:")?),
+        y: Some(field("Absolute upper-left Y:")?),
+        width: u32::try_from(field("Width:")?).ok()?,
+        height: u32::try_from(field("Height:")?).ok()?,
+    })
+}
