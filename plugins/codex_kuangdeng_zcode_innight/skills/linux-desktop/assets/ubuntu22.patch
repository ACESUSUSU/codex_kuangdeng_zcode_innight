+async fn read_actions(action: &atspi::proxy::action::ActionProxy<'_>) -> Vec<atspi::Action> {
+    // Ubuntu 22.04's ATK bridge can abort the target app while serializing GetActions.
+    // Read the same fields individually instead.
+    let mut actions = Vec::new();
+    // zbus derives "Nactions" from nactions(); the AT-SPI property is "NActions".
+    for index in 0..action.inner().get_property::<i32>("NActions").await.unwrap_or(0) {
+        actions.push(atspi::Action {
+            name: action.get_name(index).await.unwrap_or_default(),
+            description: action.get_description(index).await.unwrap_or_default(),
+            keybinding: action.get_key_binding(index).await.unwrap_or_default(),
+        });
+    }
+    actions
+}
