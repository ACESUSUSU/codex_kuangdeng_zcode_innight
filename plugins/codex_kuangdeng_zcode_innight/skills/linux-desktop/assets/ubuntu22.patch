+import json
+import math
+import sys
+import time
+
+import cairo
+import gi
+
+gi.require_version("Gtk", "3.0")
+gi.require_version("Gdk", "3.0")
+from gi.repository import Gdk, GLib, Gtk
+
+
+class PointerFeedback(Gtk.Window):
+    def __init__(self):
+        super().__init__(type=Gtk.WindowType.POPUP)
+        self.set_title("Codex pointer feedback")
+        self.set_default_size(80, 80)
+        self.set_app_paintable(True)
+        self.set_accept_focus(False)
+        self.set_focus_on_map(False)
+        self.set_keep_above(True)
+        self.set_skip_taskbar_hint(True)
+        self.set_skip_pager_hint(True)
+        self.set_visual(self.get_screen().get_rgba_visual())
+        self.input_shape_combine_region(cairo.Region())
+        self.connect("draw", self.draw_pointer)
+        self.connect("realize", self.make_pass_through)
+        self.pointer = Gdk.Display.get_default().get_default_seat().get_pointer()
+        self.until = 0
+        self.started = 0
+        self.action = "hover"
+        GLib.io_add_watch(sys.stdin, GLib.IO_IN | GLib.IO_HUP, self.receive)
+        GLib.timeout_add(30, self.tick)
+
+    def make_pass_through(self, widget):
+        surface = widget.get_window()
+        surface.set_pass_through(True)
+        surface.input_shape_combine_region(cairo.Region(), 0, 0)
+
+    def receive(self, stream, condition):
+        if condition & GLib.IO_HUP:
+            Gtk.main_quit()
+            return False
+        line = stream.readline()
+        if not line:
+            Gtk.main_quit()
+            return False
+        self.action = json.loads(line)["action"]
+        self.started = time.monotonic()
+        self.until = self.started + 3.0
+        return True
+
+    def tick(self):
+        if time.monotonic() >= self.until:
+            self.hide()
+            return True
+        _, x, y = self.pointer.get_position()
+        self.move(x - 40, y - 40)
+        self.show_all()
+        self.queue_draw()
+        return True
+
+    def draw_pointer(self, widget, context):
+        context.set_operator(cairo.OPERATOR_SOURCE)
+        context.set_source_rgba(0, 0, 0, 0)
+        context.paint()
+        context.set_operator(cairo.OPERATOR_OVER)
+        age = time.monotonic() - self.started
+        radius = 20 + (6 * abs(math.sin(age * 5)) if self.action == "click" else 0)
+        context.set_source_rgba(0.05, 0.8, 0.78, 0.95)
+        context.set_line_width(3)
+        context.arc(40, 40, radius, 0, math.tau)
+        context.stroke()
+        context.move_to(40, 40)
+        context.line_to(40, 57)
+        context.line_to(45, 52)
+        context.line_to(51, 61)
+        context.line_to(55, 59)
+        context.line_to(49, 50)
+        context.line_to(56, 49)
+        context.close_path()
+        context.set_source_rgba(0.05, 0.8, 0.78, 1)
+        context.fill_preserve()
+        context.set_line_width(1.5)
+        context.set_source_rgba(1, 1, 1, 1)
+        context.stroke()
+        return False
+
+
+PointerFeedback()
+Gtk.main()
